BOT_TOKEN=your_bot_token_here
WEBHOOK_BASE_URL=https://your-domain.com
WEBHOOK_PATH=/your-bot-path/
SECRET_TOKEN=your_random_secret_token

# PostgreSQL у compose: хост = ім'я сервісу postgres; user/password/dbname = POSTGRES_* нижче
# (пароль лише з літер/цифр, напр. `openssl rand -hex 24`, інакше його треба url-кодувати)
DB_LINK_CONNECTION=postgresql+asyncpg://user:password@postgres:5432/dbname

POSTGRES_DB=dbname
POSTGRES_USER=user
POSTGRES_PASSWORD=change_me

# Лише на час переносу даних зі старого MySQL (scripts/mysql_to_pg.py); потім видалити
# MYSQL_SOURCE_URL=mysql+aiomysql://readonly_user:password@host.docker.internal:3306/dbname?charset=utf8mb4

# Лише для розробки: тестова БД (ім'я має містити "test"); за замовчуванням postgres:16-alpine у docker
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:test@127.0.0.1:55432/tgb_test

LOG_PATH=logs/app.log

MCP_PATH=/mcp
MESSAGE_RETENTION_DAYS=180
MESSAGE_KEEP_LAST_PER_CHAT=100
AUDIT_RETENTION_DAYS=365
